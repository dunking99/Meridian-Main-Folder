age",description:"Create a sleek, modern landing page",icon:Y.SelectWindow,action:{type:"modality",modality:r.Jg.WEBDEV},template:"Create a premium, modern, conversion-focused landing page for [Brand/Product Name] targeting [Target Audience], with the goal of [Primary Goal]. Design it with the polish of leading tech brands—clean typography, generous whitespace, refined gradients, subtle glassmorphism, premium visuals, and smooth, elegant animations including scroll reveals, staggered entrances, hover effects, ambient motion, and interactive microinteractions. Include a complete landing page structure (sticky navbar, hero, social proof, features, product showcase, benefits, testimonials, pricing, FAQ, CTA, and footer), ensuring it is fully responsive, accessible, mobile-first, visually stunning, and production-ready with compelling copy tailored to the brand."},{id:"build-dashboard",headline:"Build a dashboard",description:"Turn data into interactive charts",icon:Y.StatsReport,action:{type:"modality",modality:r.Jg.WEBDEV},template:"Create an interactive analytics dashboard for [Domain — e.g. SaaS metrics, fitness tracking, personal finance] aimed at [Users]. Include KPI summary cards with trend indicators, a mix of line, bar, and donut charts with hover tooltips and smooth transitions, a sortable and filterable data table, and date-range and segment filters that update every view live. Use a clean, modern visual style with clear layout hierarchy and a dark mode toggle, generate realistic sample data so every chart feels alive, and make it fully responsive."},{id:"make-a-game",headline:"Make a game",description:"Build a playable browser game",icon:Y.Arcade,action:{type:"modality",modality:r.Jg.WEBDEV},template:"Build a polished, playable browser game: [Game Idea — e.g. a fast-paced snake remix, a physics puzzler, a typing racer]. Make the core loop fun within the first ten seconds, with tight controls for both keyboard and touch, and juicy feedback — screen shake, particle effects, and satisfying animations. Include a start screen, a score system, pause and game-over states with instant restart, and a local high-score table. Style it with a cohesive visual theme and make sure it runs smoothly at 60fps on desktop and mobile."},{id:"design-to-code",headline:"Design to Code",description:"Upload an image and have AI build it",icon:Y.FrameSelect,action:{type:"modality",modality:r.Jg.WEBDEV,opensFilePicker:!0},template:"Recreate the attached design as a pixel-perfect, production-ready web page. Match the layout, spacing, typography, colors, and imagery exactly, and implement it with clean, semantic markup and modern CSS. Make it fully responsive across mobile, tablet, and desktop, add tasteful hover states and scroll animations that fit the design's style, and where any detail is ambiguous, make polished, on-brand decisions that elevate the original."},{id:"build-fullstack-app",headline:"Build a fullstack app",description:"Create a templated full-stack app",icon:Y.Database,action:{type:"modality",modality:r.Jg.WEBDEV},template:"Build a full-stack [App Type — e.g. task manager, booking tool, team dashboard] for [Target Users] with [Key Features]. Include authentication, a clean dashboard layout with sidebar navigation, full CRUD flows for the core resources, and persistent data storage. Use a modern, polished UI with empty states, loading states, optimistic updates, and responsive design, and seed it with realistic demo data so the app feels alive on first load."},{id:"launch-storefront",headline:"Launch a storefront",description:"Create a beautiful online shop",icon:Y.ShopFourTiles,action:{type:"modality",modality:r.Jg.WEBDEV},template:"Build a beautiful e-commerce storefront for [Store Name] selling [Product Type] to [Target Customers]. Include a striking home page with featured collections, a product grid with filters and sorting, rich product detail pages with image galleries and reviews, a slide-out cart, and a streamlined checkout flow. Use elegant typography, premium product imagery, tasteful animations, and persistent cart state, and seed it with realistic demo products, prices, and reviews so the shop feels open for business — all fully responsive and production-ready."}];function e0(e){let t,a,r,s,o,d,c=(0,i.c)(30),{openFilePicker:u}=e,m=(0,eX.h)(),{navigate:f}=(0,eQ.p)(),p=(0,eZ.Xr)(eK.Lm),h=(0,L.kH)(e2),g=(0,l.rd)(),x=!0===(0,eo._P)("image-edit-promo-banner");if(c[0]!==m||c[1]!==x||c[2]!==f||c[3]!==u||c[4]!==g||c[5]!==p||c[6]!==h){let e,i,l;c[11]!==x?(e=e=>x?"launch-storefront"!==e.id:"edit-image"!==e.id,c[11]=x,c[12]=e):e=c[12];let o=e1.filter(e);c[13]!==m||c[14]!==f||c[15]!==u||c[16]!==g||c[17]!==p||c[18]!==h?(i=e=>{let{action:t}=e;if(X.analytics.capture({action:"homepage_cta_click",params:{cta_id:e.id,target_modality:"agent"===t.type?"agentic":t.modality,user_id:h}}),"agent"===t.type){sessionStorage.setItem(eq.K,e.template),g.push(m);return}t.opensFilePicker?u(()=>{p(e.template),f({modality:t.modality})}):(f({modality:t.modality}),p(e.template))},c[13]=m,c[14]=f,c[15]=u,c[16]=g,c[17]=p,c[18]=h,c[19]=i):i=c[19];let d=i;r="flex w-full flex-col gap-2",c[20]===Symbol.for("react.memo_cache_sentinel")?(s=(0,n.jsx)("span",{className:"body-xs text-text-tertiary !font-book motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-5 motion-safe:fill-mode-both text-left motion-safe:duration-300 motion-safe:ease-out",children:"Get started"}),c[20]=s):s=c[20],t="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0",c[21]!==d?(l=(e,t)=>{let a=e.icon;return(0,n.jsxs)("button",{type:"button",style:{animationDelay:`${35*t}ms`},onClick:()=>d(e),className:"border-border-medium bg-surface-primary hover:bg-surface-tertiary focus-visible:ring-ring focus-visible:ring-offset-surface-primary motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-5 motion-safe:fill-mode-both group flex min-w-[200px] flex-1 shrink